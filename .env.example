# Copy this file to .env, then replace the placeholder values.
# .env is ignored by Git; this example file is safe to commit.

# Optional: provide a complete pyodbc connection string instead of DB_* values.
PS_CONN_STR=

DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=YOUR_SERVER\SQLEXPRESS
DB_DATABASE=YOUR_DATABASE_NAME
DB_TRUSTED_CONNECTION=yes

# Used only when DB_TRUSTED_CONNECTION is no/false/0.
DB_USER=
DB_PASSWORD=
